use strict;
use warnings;
use Test::More;
use JSON::PP;
use FindBin;
open my $p,'-|',$^X,"$FindBin::Bin/original-r4-guild-file-edge-probe.pl" or die $!;
binmode $p,':raw';local $/;my $s=<$p>;close $p or die 'guild edge probe failed';
my $o=JSON::PP->new->utf8->decode($s);
is($o->{missingCount},0,'source missing read yields empty ledger');
is($o->{malformedMoney},12,'source still accepts first malformed row value');
is($o->{malformedInDefined},0,'source malformed row can leave undefined value');
like($o->{invalidGenerated},qr/,nope,60,/,'source writes unvalidated rate text');
ok($o->{removed},'negative treasury deletes definition source file');
ok($o->{tempGone},'period removes transient guild field');
is($o->{negativeAfter}{in},0,'period resets income');
is($o->{negativeAfter}{out},0,'period resets outgo');
like($o->{staleDefinition},qr/'alpha'=>/,'already loaded definition persists after unlink');
unlike($o->{afterReload},qr/'alpha'=>/,'next ReadGuild drops missing definition');
is_deeply([map{$_->{rebuild}?1:0}@{$o->{mtime}}],[0,1,0],'original strictly newer mtime condition');
done_testing();
