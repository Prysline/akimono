use strict;
use warnings;
use utf8;
use Test::More;
use JSON::PP;
use FindBin;
open my $p,'-|',$^X,"$FindBin::Bin/original-r4-guild-files-probe.pl" or die $!;
binmode $p,':raw';
local $/;my $s=<$p>;close $p or die 'probe failed';
my $o=JSON::PP->new->utf8->decode($s);
is_deeply($o->{oldKeys},['alpha','old'],'MakeGuildFile does not replace in-memory keys');
is_deeply([sort keys %{$o->{definitions}}],['alpha','beta'],'generated Perl definition reload');
is($o->{definitions}{alpha}{shortname},'新&lt;公會&gt;','real ReadConfig escaping');
is($o->{ledger}{alpha}{money},1080,'positive and negative source edits');
is($o->{ledger}{alpha}{in},127,'positive source edit');
is($o->{ledger}{alpha}{out},48,'negative source edit');
is($o->{afterShops}[0]{guild},'','removed guild membership');
ok(!exists $o->{afterShops}[0]{user}{_so_e},'removed guild user field');
is(scalar @{$o->{logs}},2,'new and disbanded guild logs');
is(scalar @{$o->{partialPending}},1,'partial rename leaves pending file');
ok($o->{recovered},'original commit recovery');
done_testing();
