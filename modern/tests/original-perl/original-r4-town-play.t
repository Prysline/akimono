use strict;
use warnings;
use Test::More;
use FindBin;
use JSON::PP;
open my $p,'-|',$^X,"$FindBin::Bin/original-r4-town-play-probe.pl" or die $!;
binmode $p,':raw';local $/;my $s=<$p>;close $p or die 'town probe failed';
my $o=JSON::PP->new->utf8->decode($s);
is(scalar @{$o->{cases}},2,'two actual source writes');
my($a,$b)=@{$o->{cases}};
is($a->{input}{town}{dominion},'beta','real guildbattle END selects highest live treasury');
is($a->{input}{town}{zero},'0','zero retained');
like($a->{input}{town}{notice},qr/%2c100%25%0a/,'source comma percent LF escapes');
is($a->{lookups}[3],'','GetTownData decodes key instead of encoding');
is_deeply($b->{before},$a->{input}{town},'DataRead reloads prior town');
ok(!exists($b->{input}{town}{delete}),'empty value deletes key');
is($b->{input}{town}{dominion},'beta','winner persists next write');
is($a->{staged},$a->{live},'first real commit');
is($b->{staged},$b->{live},'second real commit');
done_testing();
