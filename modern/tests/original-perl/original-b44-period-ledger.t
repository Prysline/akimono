use strict;
use warnings;
use utf8;
use Test::More;
use JSON::PP qw(decode_json);
use FindBin;
use File::Spec;
my $probe=File::Spec->catfile($FindBin::Bin,'original-b44-period-ledger-probe.pl');
my $out=qx{perl "$probe"};
is($?,0,'B-44 frozen Core per-shop period ledger actually executes');
my $oracle=eval {decode_json($out)};
ok(!$@ && ref($oracle)eq'HASH','Perl original period evidence JSON');
if(ref($oracle)eq'HASH'){
  is(scalar(@{$oracle->{limits}}),79,'original period iterates 79 slots');
  is(scalar(@{$oracle->{cases}}),3,'three source accounting fixtures');
  my ($first,$second,$third)=map {$_->{output}} @{$oracle->{cases}};
  is($first->{profitstock},0,'two net-zero trades retain profitstock 0');
  is($first->{saleyesterday},10000,'source stores 10000 last sales');
  is($first->{payyesterday},10000,'source stores 10000 last expenses');
  is($first->{paytoday},15,'original maintenance truncation adds into new current paytoday');
  is($first->{money},99985,'original maintenance cash debit');
  is($first->{itemyesterday}{10},2,'itemtoday moves to yesterday');
  is_deeply($first->{itemtoday},{},'source resets current item count');
  is($first->{exp}{10},89,'original percent plus 5 exp decay');
  is($first->{exp}{79},1,'original near-zero exp remains 1');
  is($second->{profitstock},-1250,'source weighted profit preserves loss');
  is($second->{item}[9],20,'source clamps item10 above legal max');
  is($second->{item}[78],10,'source clamps item79 at 10');
  is($second->{money},50,'cost int(300.125) is 300');
  is($second->{paytoday},300,'period maintenance booked as next period spending');
  is($second->{costyesterday},300,'source retains charged cost');
  is_deeply($second->{exp},{79=>935},'exp <=0 deleted; exp 1000 decays to 935');
  is($third->{money},-994,'original allows negative cash after maintenance');
  is($third->{profitstock},-750,'negative weighted profit uses Perl int toward zero');
  is($third->{taxyesterday},9,'tax history rolls to prior period');
  is($third->{taxtoday},0,'current period tax cleared');
  is($third->{item}[9],1,'stock other than max correction unchanged');
}
done_testing();
