use strict;
use warnings;
use utf8;
use Test::More;
use FindBin;
use JSON::PP;
open my $p,'-|',$^X,"$FindBin::Bin/original-r4-external-joint-probe.pl" or die $!;
binmode $p,':raw';local $/;my $s=<$p>;close $p or die 'joint source probe failed';
my $o=JSON::PP->new->utf8->decode($s);
my($a,$b)=@{$o->{cases}};
is($a->{input}{town}{dominion},'beta','actual guildbattle END');
is_deeply($a->{eventOutput}{events},{},'both source events ended');
is_deeply($a->{eventOutput}{ranges},[100000],'only guild zero START draw');
is($a->{armyStage},"\n\n",'original army prunes stale and zero soldiers');
is($a->{armyLive},$a->{armyStage},'actual shared commit moved army');
like($a->{guildStage},qr/\tguild\t(?:alpha|beta)(?:\t|\n)/,'actual WriteGuildData retains transient guild field');
is($a->{guildLive},$a->{guildStage},'actual shared commit moved guild ledger');
is($a->{live},$a->{staged},'actual shared commit moved play');
is_deeply($b->{before},$a->{input}{town},'next turn reads prior live town');
ok(!defined($b->{armyStage}),'next turn no army callback/write');
is($b->{armyLive},$a->{armyLive},'next turn preserves live army');
is_deeply($b->{eventOutput}{ranges},[100000,100000],'two inactive source gates');
done_testing();
